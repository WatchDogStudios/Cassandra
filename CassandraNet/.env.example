# Copy to .env and replace every secret. Generate random values with:
#   openssl rand -hex 32
# Compose refuses to start while a required value is missing.

POSTGRES_DB=cassandra
POSTGRES_USER=cassandra
POSTGRES_PASSWORD=change-me
CASS__DATABASE__URL=postgres://cassandra:change-me@postgres:5432/cassandra

# HS256 signing key for access/refresh tokens. Required; use >= 32 random bytes.
CASS_JWT_SECRET=

# Password for admin@localhost, seeded on gateway start.
CASS_ADMIN_PASSWORD=

# Key the agent container uses (granted the agent:execute scope automatically).
CASS_AGENT_SECRET=

# Let operators run commands and scripts inside the agent container.
CASS_AGENT_ALLOW_EXEC=false

# Extra bootstrap API keys as key:scope|scope,... (prefer DB-managed keys).
CASS_API_KEYS=

# Refresh cookies are Secure by default. Browsers accept that on http://localhost;
# set to false only when serving the console over plain HTTP on another host.
CASS_COOKIE_SECURE=true

# Optional per-route rate limits as route:limit:window_secs,...
# e.g. auth.login:5:60,ugc:create_upload:100:60
CASS_RATE_LIMITS=

RUST_LOG=info
